<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- IDE0005 (unused usings) is only reported at build time when XML docs are generated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: we do not require XML doc comments on every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Culture-independent behaviour everywhere (Turkish I/ı bug class), tests included. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
