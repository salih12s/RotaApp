{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5000", "Protocols": "Http1" },
      "Grpc": { "Url": "http://localhost:5200", "Protocols": "Http2" }
    }
  },
  "Auth": { "Audience": "rota-api" },
  "RateLimit": {
    "Rules": [
      { "Name": "create-order", "Method": "POST", "PathPrefix": "/api/v1/orders", "Limit": 50, "PerSeconds": 1, "Key": "merchant" },
      { "Name": "anonymous-tracking", "PathPrefix": "/graphql", "Limit": 10, "PerSeconds": 60, "Key": "ip" },
      { "Name": "rest", "PathPrefix": "/api", "Limit": 200, "PerSeconds": 1, "Key": "subject" }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "orders": { "ClusterId": "orders", "Match": { "Path": "/api/v1/orders/{**rest}" } },
      "webhook-subscription": { "ClusterId": "notifications", "Match": { "Path": "/api/v1/webhook-subscription/{**rest}" } },
      "webhook-deliveries": { "ClusterId": "notifications", "Match": { "Path": "/api/v1/webhook-deliveries/{**rest}" } },
      "dispatch-couriers": { "ClusterId": "dispatch", "Match": { "Path": "/api/v1/couriers/{**rest}" } },
      "dispatch-offers": { "ClusterId": "dispatch", "Match": { "Path": "/api/v1/offers/{**rest}" } },
      "dispatch-jobs": { "ClusterId": "dispatch", "Match": { "Path": "/api/v1/dispatch-jobs/{**rest}" } },
      "grpc-location-ingest": { "ClusterId": "tracking-grpc", "Match": { "Path": "/rota.tracking.v1.CourierLocationIngest/{**rest}" } },
      "grpc-courier-offers": { "ClusterId": "dispatch-grpc", "Match": { "Path": "/rota.dispatch.v1.CourierOffers/{**rest}" } }
    },
    "Clusters": {
      "orders": { "Destinations": { "d1": { "Address": "http://localhost:5101" } } },
      "notifications": { "Destinations": { "d1": { "Address": "http://localhost:5104" } } },
      "dispatch": { "Destinations": { "d1": { "Address": "http://localhost:5102" } } },
      "tracking-grpc": {
        "HttpRequest": { "Version": "2", "VersionPolicy": "RequestVersionExact" },
        "Destinations": { "d1": { "Address": "http://localhost:5203" } }
      },
      "dispatch-grpc": {
        "HttpRequest": { "Version": "2", "VersionPolicy": "RequestVersionExact" },
        "Destinations": { "d1": { "Address": "http://localhost:5202" } }
      }
    }
  }
}
